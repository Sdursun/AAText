# AAText preferences - copy to ENVARC:AAText.prefs (and ENV:AAText.prefs)
#
# bitmapfont  size  ->  ttf file                         [pixelsize]
#
# - "bitmapfont" is the font name as shown in Font prefs (without .font);
#   use double quotes if it contains spaces.
# - "size" must match the font size exactly.
# - pixelsize is optional; without it AAText picks the size whose
#   character widths best match the bitmap font.
# - "real" (optional) uses the TrueType font's own character widths
#   instead of squeezing letters into the bitmap font's cells. Text looks
#   more natural, but window layouts change: start AAText before other
#   programs (WBStartup); windows that were already open keep their old
#   layout until reopened. Try it with one font first:
#       Arial  22  ->  FONTS:_TrueType/arial.ttf  real
# - Fonts without a mapping are drawn by the system as before.

Arial                  22  ->  FONTS:_TrueType/arial.ttf
"BitStream Vera Sans"  16  ->  FONTS:_TrueType/Vera.ttf

# Gamma for the antialiasing edge (0.5 - 4.0, default 1.8).
# Higher values make text look bolder.
gamma 1.8

# Character set of your bitmap fonts: latin1 (default) or latin5 (Turkish)
charset latin1

# Glyph cache size in KB (32 - 16384, default 256). Least recently used
# glyphs are dropped when it is full.
cache 256

# Programs AAText must not touch (Workbench program name or Shell command
# name, case does not matter). Several lines are allowed.
#blacklist FinalWriter TypeSmith

# Some programs draw text into hidden bitmaps first (e.g. docks, gauges).
# "on" draws those with the Workbench screen colours; colours may be wrong
# if the program is not on the Workbench screen. Default off.
#offscreen on
