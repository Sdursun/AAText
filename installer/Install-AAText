; $VER: Install-AAText 1.0 (14.10.2026)
;
; Installer script for AAText (AmigaOS 3.2 SYS:System/Installer).
; UTF-8 here; "make dist" converts it to ISO-8859-9 for the package.
;
; Installs: C:AAText (68020 or 68060 build), SYS:Prefs/AATextPrefs,
; SYS:System/AATextManager with LIBS:aatext.library (both programs as
; ReAction or, with MUI 3.8 or newer, MUI build), the Turkish
; catalogs, the documents in LOCALE:Help/türkçe and LOCALE:Help/english,
; and "Run >NIL: C:AAText" in S:Startup-Sequence right after IPrefs
; (C:AAText STARTUP=ADD; S:User-Startup if that is not possible).
; Settings (ENVARC:AAText.prefs) are never touched.

(set @app-name "AAText")
(set #tr (= @language "türkçe"))

(set #catdir "LOCALE:Catalogs/türkçe")
(set #helptr "LOCALE:Help/türkçe")
(set #helpen "LOCALE:Help/english")

; --------------------------------------------------------------------
; Install or remove

(set #mode
  (askchoice
    (prompt (if #tr "AAText'i kurmak mı, kaldırmak mı istiyorsunuz?"
                    "Do you want to install or remove AAText?"))
    (help (if #tr "Kaldır: kurulan dosyaları ve S:User-Startup'taki AAText satırını siler. Ayarlarınız (ENVARC:AAText.prefs) kalır."
                  "Remove: deletes the installed files and the AAText line in S:User-Startup. Your settings (ENVARC:AAText.prefs) are kept."))
    (choices (if #tr "Kur ya da güncelle" "Install or update")
             (if #tr "Kaldır" "Remove"))
    (default 0)))

(if (= #mode 1)
(
  ; ------------------------------------------------------------ remove
  (run "C:AAText QUIT >NIL:")
  (if (exists "C:AAText")
    (if (askbool
          (prompt (if #tr "AAText'i başlatan satır S:Startup-Sequence'ten kaldırılsın mı?\n(Yedek: S:Startup-Sequence.AAText-bak)"
                          "Remove the line that starts AAText from S:Startup-Sequence?\n(Backup: S:Startup-Sequence.AAText-bak)"))
          (help @startup-help)
          (default 1))
      (run "C:AAText >NIL: STARTUP=REMOVE")))
  (if (exists "C:AAText")
    (delete "C:AAText"
      (prompt (if #tr "C:AAText silinsin mi?" "Delete C:AAText?"))
      (help @delete-help) (confirm)))
  (if (exists "SYS:Prefs/AATextPrefs")
    (delete "SYS:Prefs/AATextPrefs" (infos)
      (prompt (if #tr "SYS:Prefs/AATextPrefs silinsin mi?" "Delete SYS:Prefs/AATextPrefs?"))
      (help @delete-help) (confirm)))
  (if (exists "SYS:System/AATextManager")
    (delete "SYS:System/AATextManager" (infos)
      (prompt (if #tr "SYS:System/AATextManager silinsin mi?" "Delete SYS:System/AATextManager?"))
      (help @delete-help) (confirm)))
  ; LIBS:aatext.library stays: fonts installed with the engine "aatext"
  ; (also the screen font) cannot be opened without it
  (if (exists (tackon #catdir "aatextprefs.catalog"))
    (delete (tackon #catdir "aatextprefs.catalog")))
  (if (exists (tackon #catdir "aatextmanager.catalog"))
    (delete (tackon #catdir "aatextmanager.catalog")))
  (if (exists (tackon #helptr "AAText_TR.txt"))
    (delete (tackon #helptr "AAText_TR.txt")))
  (if (exists (tackon #helpen "AAText_EN.txt"))
    (delete (tackon #helpen "AAText_EN.txt")))
  ; an AAText block in S:User-Startup (older installers) becomes a comment
  (if (= 0 (run "C:Search >NIL: S:User-Startup \";BEGIN AAText\" QUIET"))
    (startup "AAText"
      (prompt (if #tr "S:User-Startup'taki AAText satırı kaldırılsın mı?"
                      "Remove the AAText line from S:User-Startup?"))
      (help @startup-help)
      (command "; AAText removed\n")))
  (exit (if #tr "AAText kaldırıldı. Ayarlar (ENVARC:AAText.prefs) yerinde duruyor; değişiklik yeniden başlatınca tamamlanır."
                "AAText has been removed. The settings (ENVARC:AAText.prefs) are kept; the change is complete after a reboot.")
        (quiet))
))

; ---------------------------------------------------------------- install

(if (exists "C:AAText")
  (set #old (getversion "C:AAText"))
  (set #old 0))
(set #new (getversion "AAText"))
(if #old
  (message
    (if #tr
      (cat "Kurulu AAText: " (/ #old 65536) "." (BITAND #old 65535)
           "\nYeni sürüm: " (/ #new 65536) "." (BITAND #new 65535)
           "\n\nDosyalar güncellenecek, ayarlarınız korunur.")
      (cat "Installed AAText: " (/ #old 65536) "." (BITAND #old 65535)
           "\nNew version: " (/ #new 65536) "." (BITAND #new 65535)
           "\n\nThe files will be updated, your settings are kept."))))

(set #cpu (database "cpu"))
(set #build
  (askchoice
    (prompt (if #tr (cat "Hangi AAText sürümü kurulsun? (işlemci: " #cpu ")")
                    (cat "Which AAText build should be installed? (processor: " #cpu ")")))
    (help (if #tr "68060 sürümü yalnızca FPU'lu gerçek bir 68060 içindir. PiStorm/Emu68, WinUAE, 68020/030/040 ve FPU'suz 68LC060 için 68020/030/040 sürümünü seçin."
                  "The 68060 build is for a real 68060 with FPU only. For PiStorm/Emu68, WinUAE, 68020/030/040 and the 68LC060 without FPU choose the 68020/030/040 build."))
    (choices "68020/030/040" "68060")
    (default (if (= #cpu "68060") 1 0))))

(set #parts
  (askoptions
    (prompt (if #tr "Hangi parçalar kurulsun? (AAText her zaman kurulur)"
                    "Which parts should be installed? (AAText is always installed)"))
    (help (if #tr "AATextPrefs: ayar programı (SYS:Prefs).\nAATextManager: font kurucu, onarım ve tanılama (SYS:System, LIBS:aatext.library ile).\nTürkçe kataloglar: Türkçe arayüz (LOCALE:Catalogs/türkçe).\nBelgeler: LOCALE:Help/türkçe ve LOCALE:Help/english."
                  "AATextPrefs: the settings program (SYS:Prefs).\nAATextManager: font installer, repair and diagnostics (SYS:System, with LIBS:aatext.library).\nTurkish catalogs: Turkish user interface (LOCALE:Catalogs/türkçe).\nDocuments: LOCALE:Help/türkçe and LOCALE:Help/english."))
    (choices "AATextPrefs"
             "AATextManager + aatext.library"
             (if #tr "Türkçe kataloglar" "Turkish catalogs")
             (if #tr "Belgeler" "Documents"))
    (default 15)))

;  The window of AATextPrefs and AATextManager: ReAction (part of the
;  OS) or MUI (needs muimaster.library 19, MUI 3.8, or newer). The MUI
;  programs are in MUI/ and get the same names, so icons, the
;  AATextManager button of AATextPrefs and the documents stay valid.
(set #gui 0)
(if (OR (IN #parts 0) (IN #parts 1))
(
  (set #muiver 0)
  (if (exists "LIBS:muimaster.library")
    (set #muiver (getversion "LIBS:muimaster.library"))
    (if (exists "MUI:Libs/muimaster.library")
      (set #muiver (getversion "MUI:Libs/muimaster.library"))))
  (if (>= (/ #muiver 65536) 19)
    (set #gui
      (askchoice
        (prompt (if #tr "AATextPrefs ve AATextManager hangi arayüzle kurulsun?"
                        "Which user interface should AATextPrefs and AATextManager use?"))
        (help (if #tr "ReAction: AmigaOS 3.2'nin kendi arayüzü.\nMUI: MUI 3.8 veya üstü gerekir; görünüşü MUI ayarlarınıza uyar.\n\nİki sürüm de aynı ayarları ve katalogları kullanır. Daha sonra kurulumu yeniden çalıştırıp değiştirebilirsiniz."
                      "ReAction: the user interface of AmigaOS 3.2.\nMUI: needs MUI 3.8 or newer; it looks as your MUI settings say.\n\nBoth builds use the same settings and catalogs. You can run the installer again to change it later."))
        (choices "ReAction" "MUI")
        (default 1)))
    (message (if #tr "MUI 3.8 veya üstü bulunamadı (muimaster.library 19); AATextPrefs ve AATextManager ReAction arayüzüyle kurulacak."
                     "MUI 3.8 or newer was not found (muimaster.library 19); AATextPrefs and AATextManager are installed with the ReAction user interface.")))
))
(set #guidir (if (= #gui 1) "MUI/" ""))

(copyfiles
  (prompt (if #tr "AAText, C: içine kopyalanıyor." "Copying AAText to C:."))
  (help @copyfiles-help)
  (source (if (= #build 1) "AAText.060" "AAText"))
  (dest "C:")
  (newname "AAText"))
(protect "C:AAText" "+e")
(complete 20)

(if (IN #parts 0)
  (copyfiles
    (prompt (if #tr "AATextPrefs, SYS:Prefs içine kopyalanıyor." "Copying AATextPrefs to SYS:Prefs."))
    (help @copyfiles-help)
    (source (cat #guidir "AATextPrefs")) (dest "SYS:Prefs")
    (newname "AATextPrefs")))
(if (IN #parts 0)
  (copyfiles (source "AATextPrefs.info") (dest "SYS:Prefs")))
(complete 40)

(if (IN #parts 1)
(
  (copyfiles
    (prompt (if #tr "AATextManager, SYS:System içine kopyalanıyor." "Copying AATextManager to SYS:System."))
    (help @copyfiles-help)
    (source (cat #guidir "AATextManager")) (dest "SYS:System")
    (newname "AATextManager"))
  (copyfiles (source "AATextManager.info") (dest "SYS:System"))
  (copylib
    (prompt (if #tr "aatext.library, LIBS: içine kopyalanıyor." "Copying aatext.library to LIBS:."))
    (help @copylib-help)
    (source "Libs/aatext.library") (dest "LIBS:") (confirm))
))
(complete 60)

(if (IN #parts 2)
(
  (if (not (exists #catdir)) (makedir #catdir))
  (if (IN #parts 0)
    (copyfiles (source "Catalogs/türkçe/aatextprefs.catalog") (dest #catdir)))
  (if (IN #parts 1)
    (copyfiles (source "Catalogs/türkçe/aatextmanager.catalog") (dest #catdir)))
))
(complete 70)

(if (IN #parts 3)
(
  (if (not (exists #helptr)) (makedir #helptr))
  (if (not (exists #helpen)) (makedir #helpen))
  (copyfiles (source "AAText_TR.txt") (dest #helptr))
  (copyfiles (source "AAText_EN.txt") (dest #helpen))
))
(complete 80)

; S:Startup-Sequence, right after IPrefs (C:AAText edits it with a backup;
; a line that starts AAText already is left alone)
(set #ss 0)
(if (askbool
      (prompt (if #tr "AAText her açılışta başlasın diye S:Startup-Sequence'te IPrefs satırının altına\n\n  Run >NIL: C:AAText\n\nsatırı eklensin mi? AAText'i zaten başlatan bir satır varsa dosyaya dokunulmaz.\n(Yedek: S:Startup-Sequence.AAText-bak)"
                      "Add\n\n  Run >NIL: C:AAText\n\nto S:Startup-Sequence right after IPrefs, so AAText starts at every boot? If a line starts AAText already, the file is left alone.\n(Backup: S:Startup-Sequence.AAText-bak)"))
      (help (if #tr "AAText, Workbench pencerelerini açmadan (LoadWB) önce ve RTG sürücüleri ile IPrefs'ten sonra çalışmalıdır. Hayır derseniz satır S:User-Startup'a eklenir."
                    "AAText must run before Workbench opens its windows (LoadWB) and after the RTG drivers and IPrefs. If you say no, the line goes to S:User-Startup instead."))
      (default 1))
  (if (= 0 (run "C:AAText >NIL: STARTUP=ADD"))
    (set #ss 1)
    (message
      (if #tr "S:Startup-Sequence'te IPrefs ya da LoadWB satırı bulunamadı ya da dosya yazılamadı; dosya değiştirilmedi. Satır S:User-Startup'a eklenecek."
              "S:Startup-Sequence has no IPrefs or LoadWB line, or cannot be written; it was not changed. The line goes to S:User-Startup instead."))))

(if #ss
  ; an AAText block of an older installer would start it a second time
  (if (= 0 (run "C:Search >NIL: S:User-Startup \";BEGIN AAText\" QUIET"))
    (startup "AAText"
      (prompt (if #tr "AAText artık S:Startup-Sequence'ten başlıyor; S:User-Startup'taki eski AAText satırı kaldırılsın mı?"
                      "AAText is started from S:Startup-Sequence now; remove the old AAText line from S:User-Startup?"))
      (help @startup-help)
      (command "; AAText is started in S:Startup-Sequence\n")))
  (startup "AAText"
    (prompt (if #tr "AAText her açılışta başlasın diye S:User-Startup'a\n\n  Run >NIL: C:AAText\n\nsatırı eklensin mi?"
                    "Add\n\n  Run >NIL: C:AAText\n\nto S:User-Startup, so AAText starts at every boot?"))
    (help (if #tr "S:User-Startup, Workbench açılmadan (LoadWB) önce ve RTG sürücüleri yüklendikten sonra çalışır."
                  "S:User-Startup runs before Workbench is loaded (LoadWB) and after the RTG drivers."))
    (command "Run >NIL: C:AAText\n")))
(complete 100)

(exit (if #tr "AAText kuruldu. Bilgisayarı yeniden başlatın; AAText açılışta başlar.\n\nAyarlar: SYS:Prefs/AATextPrefs\nFont kurucu: SYS:System/AATextManager"
              "AAText has been installed. Reboot; AAText starts at boot.\n\nSettings: SYS:Prefs/AATextPrefs\nFont installer: SYS:System/AATextManager")
      (quiet))
